{
  "name": "chatbot-barberia-sheets",
  "version": "1.0.0",
  "description": "Chatbot de agendamiento por WhatsApp para una barbería, con Google Sheets como base de datos y panel web de administración",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --test",
    "demo": "node --experimental-test-module-mocks demo/servidor.mjs",
    "demo:chat": "node --experimental-test-module-mocks demo/conversacion.mjs"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "nodejs",
    "google-sheets",
    "barberia",
    "agendamiento"
  ],
  "author": "Juan Esteban Díaz (https://github.com/diaz021)",
  "dependencies": {
    "@google/genai": "^1.46.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
