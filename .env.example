# ──────────────────────────────────────────────────────────────────────
# Copia este archivo como `.env` y rellénalo. NUNCA subas el `.env`.
#
# ¿Solo quieres verlo funcionar? No hace falta nada de esto:
#     npm run demo
# corre el bot y el panel con Google y Meta simulados.
# ──────────────────────────────────────────────────────────────────────

PORT=3000

# ── WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp) ──────
API_TOKEN=
# El "Phone number ID" de Meta, NO el número de teléfono.
BUSINESS_PHONE=
API_VERSION=v21.0
# Palabra que inventas tú y pegas también en la configuración del webhook.
WEBHOOK_VERIFY_TOKEN=
# Con esto se valida la firma de cada mensaje. Si falta, queda apagada.
META_APP_SECRET=

# ── Google Sheets ─────────────────────────────────────────────────────
# El ID de la hoja: está en su URL, entre /d/ y /edit.
SPREADSHEET_ID=
# El JSON completo de la cuenta de servicio, en una sola línea.
# Comparte la hoja con el correo de esa cuenta (permiso de editor).
GOOGLE_CREDENTIALS_JSON=

# ── Panel web ─────────────────────────────────────────────────────────
# Teléfonos que pueden entrar al panel, con código de país, separados por coma.
ADMIN_PRINCIPAL=573005550199
# Cadena larga y aleatoria. Si falta, cada reinicio cierra las sesiones.
SESION_SECRETO=
URL_PUBLICA=http://localhost:3000

# ── Contraseña del panel de cada barbero (por WhatsApp) ───────────────
PASSWORD_CAMILO=
PASSWORD_MATEO=
PASSWORD_SANTIAGO=
PASSWORD_PRUEBA=

# ── Opcional: asistente con IA (hoy desconectado del menú) ────────────
GEMINI_API_KEY=
